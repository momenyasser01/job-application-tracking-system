# Copy to .env for local development.
#
# Supabase → Project Settings → Database → Connection string:
#   Direct / session pooler (port 5432): prepared statements supported
#   Transaction pooler      (port 6543): prepared statements NOT supported.
#                                        src/db/index.ts detects port 6543 and
#                                        disables them automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/jats

PORT=4000
WEB_ORIGIN=http://localhost:3000

# Tests read .env.test instead (NODE_ENV=test). Point it at a LOCAL database —
# the test suite truncates tables and refuses to run against a remote host.
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/jats_test
